/* Data pipeline page: a lean flowchart on the left; each step opens a visual explainer on the right. */
const PCOL = { extract: "#0a6bd6", validate: "#e67700", clean: "#0a8f8f", transform: "#7048e8", load: "#2f9e44" };
const PWHAT = {
  extract: "Open every file, read its header and table, and rename the columns so every city uses the same names and units.", validate: "Three gatekeepers: timestamps must be readable, each city-hour may appear once, and values must be physically possible. Failing rows go to a quarantine table with the reason; nothing disappears silently.",
  clean: "Make the hourly calendar complete so a missing hour is visible, fill gaps of up to 3 hours with a straight line between neighbours (never rainfall), and flag unusual readings instead of deleting them, so real extremes survive.",
  transform: "Add the measures the dashboard and models use: heat index (how hot it feels once humidity is counted), wet-bulb temperature, and the date and hour keys.", load: "Copy clean rows into the warehouse with an upsert: insert if the city-hour is new, update if it exists. Running the pipeline twice never creates duplicates.",
};

const PPLAIN = { extract: ["📦 Like unpacking boxes of paper records"], validate: ["🛂 Like airport security for data"], clean: ["🧼 Like fixing typos and filling blanks"], transform: ["🧮 Like adding a “feels like” column"], load: ["🗄️ Like filing it in a cabinet"] };
// Illustrative example row at each step; [value, state] where state: "" | "new" | "fix" | "bad"
const PSAMPLE = {
  extract: { say: "Files from different sources arrive with different column names. We read them and give every column one standard name.", head: ["city", "time", "temperature_2m → temperature_c", "relative_humidity_2m → humidity_pct", "precipitation → rain_mm"], rows: [[["Delhi", ""], ["14 Jul 2002, 13:00", ""], ["31.4", "new"], ["78", "new"], ["0.4", "new"]]] },
  validate: { say: "Each row faces three questions. Good rows pass. Impossible rows (like 999 °C) are set aside with a reason, not thrown away.", head: ["time", "temperature_c", "humidity_pct", "verdict"], rows: [[["13:00", ""], ["31.4", ""], ["78", ""], ["✓ Passed", "new"]], [["14:00", ""], ["999", "bad"], ["81", ""], ["✗ Quarantined: temperature impossible", "bad"]]] },
  clean: { say: "The 15:00 reading is missing. We draw a straight line between 14:00 and 16:00 and fill it in. Odd values are flagged, never deleted.", head: ["time", "temperature_c", "humidity_pct", "note"], rows: [[["14:00", ""], ["31.8", ""], ["76", ""], ["", ""]], [["15:00", ""], ["—  →  32.1", "fix"], ["—  →  75", "fix"], ["Gap filled", "fix"]], [["16:00", ""], ["32.4", ""], ["74", ""], ["", ""]]] },
  transform: { say: "We add columns that people and models actually need, calculated from what we already have.", head: ["temperature_c", "humidity_pct", "heat_index_c", "wet_bulb_c", "date_key", "hour"], rows: [[["32.1", ""], ["75", ""], ["41.0", "new"], ["27.6", "new"], ["20020714", "new"], ["15", "new"]]] },
  load: { say: "The row is saved in the warehouse. If that city-hour already exists it is updated, so nothing is ever stored twice.", head: ["city_key", "date_key", "hour", "temperature_c", "heat_index_c", "status"], rows: [[["1", ""], ["20020714", ""], ["15", ""], ["32.1", ""], ["41.0", ""], ["✓ Stored once", "new"]]] },
};
const psample = (k) => { const x = PSAMPLE[k]; return `<div class="psmp"><p class="psay">${x.say}</p><div class="scroll"><table class="ptb"><thead><tr>${x.head.map((h) => `<th>${h}</th>`).join("")}</tr></thead><tbody>${x.rows.map((rw) => `<tr>${rw.map((c) => `<td class="${c[1]}">${c[0]}</td>`).join("")}</tr>`).join("")}</tbody></table></div><small class="vxnote"></small></div>`; };
const PGUIDE = [
  ["1 · Collect", "Opening the post", "We open 210 weather files (10 cities × 21 years) and put them into one big table with common column names.", "Python, pandas", "Every file would speak its own “language” and could not be compared."],
  ["2 · Check", "Security at the airport", "Each row is tested: is the time readable, is it a repeat, is the value possible (humans can’t live in 999 °C)? Bad rows wait in a quarantine table with a reason.", "Python rules, PostgreSQL quarantine table", "Wrong numbers would quietly spoil every chart and prediction."],
  ["3 · Tidy", "Fixing a spreadsheet by hand", "Missing hours are added. Short gaps (up to 3 hours) are filled with a straight line between neighbours. Strange values are flagged but kept.", "Python, interpolation", "Holes in the data would make averages and models unreliable."],
  ["4 · Enrich", "Adding a “feels like” column", "We calculate heat index (how hot it feels), wet-bulb temperature and date/hour keys from the existing numbers.", "Python formulas", "Dashboards would show raw numbers that mean little to people."],
  ["5 · Store", "Filing into a cabinet", "Clean rows are saved into the warehouse. “Upsert” means: update if it exists, add if it is new, so re-runs never create duplicates.", "PostgreSQL (star and snowflake tables)", "We would have no single trusted place to ask questions."],
  ["6 · Use", "Reading the finished report", "The dashboard, OLAP queries and prediction models all read from the warehouse, never from raw files.", "FastAPI, JavaScript dashboard, scikit-learn", "Nothing would turn the data into decisions."],
];
const gate = (ic, color, title, rule, n) => `<div class="gate"><span class="gi" style="background:${color}1f">${ico(ic, color, 20)}</span><b>${title}</b><small>${rule}</small><em class="${n ? "bad" : "ok"}">${n ? fmtn(n) + " rejected" : "✓ none rejected"}</em></div>`;

/* ---------- evidence helpers ---------- */
const histSpark = (h, color = "#0a6bd6") => { const mx = Math.max(...h.y, 1), w = 84, hh = 26, n = h.y.length; return `<svg class="spk" viewBox="0 0 ${w} ${hh}" width="${w}" height="${hh}" aria-hidden="true">${h.y.map((v, i) => `<rect x="${((i * w) / n + 0.6).toFixed(1)}" y="${(hh - (v / mx) * hh).toFixed(1)}" width="${(w / n - 1.2).toFixed(1)}" height="${Math.max(1, (v / mx) * hh).toFixed(1)}" rx="1.5" fill="${color}"/>`).join("")}</svg>`; };
const unit = (raw) => (raw.match(/\((.*)\)$/) || [])[1] ?? "";
const STAGE_FN = { extract: ["parse_raw_csv"], validate: ["validate_timestamps", "drop_duplicates", "check_ranges"], clean: ["fill_gaps", "impute_short_gaps", "flag_outliers"], transform: ["add_derived"], load: ["load_facts"] };
const VARS = { temperature_c: "Temperature", pressure_msl_hpa: "Pressure", wind_speed_kmh: "Wind speed" };
const dlabel = (iso) => new Date(iso).toLocaleString("en-IN", { day: "2-digit", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" });

/* a plain-English label for each run, worked out from its own numbers */
function runLabels(runs) {
  const out = {}, prev = {};
  [...runs].sort((a, b) => a.run_id - b.run_id).forEach((r) => {
    const p = prev[r.pipeline];
    if (r.pipeline !== "weather") out[r.run_id] = `Crop table load · ${fmtn(r.rows_loaded)} rows${r.rows_rejected ? `, ${r.rows_rejected} set aside` : ""}`;
    else if (p === undefined) out[r.run_id] = `First load · ${fmtn(r.rows_loaded)} rows`;
    else if (r.rows_in_table_after > p) out[r.run_id] = `Added ${fmtn(r.rows_in_table_after - p)} new rows`;
    else out[r.run_id] = `Re-run · table stayed at ${fmtn(r.rows_in_table_after)} ✓`;
    prev[r.pipeline] = r.rows_in_table_after;
  });
  return out;
}

async function engineering() {
  const q = new URLSearchParams(location.hash.split("?")[1] || ""); let tab = q.get("tab") || "sources", openFn = null;
  const TABS = [["sources", "1 · Source files"], ["journey", "2 · The journey"], ["proof", "3 · Proof lab"], ["flagged", "4 · Flagged readings"], ["code", "5 · Code"]];
  view.innerHTML = `<div class="page"><header class="phead reveal"><h1>Data pipeline: prove the data is trustworthy</h1><p class="lede">Raw files go in, clean warehouse rows come out. Every claim on this page is backed by a real file, a real query or the real code running right now.</p></header>
    <div id="pstrip" class="kpis">${skeleton()}</div><div class="tabs" role="group" aria-label="Pipeline sections">${TABS.map(([k, l]) => `<button data-t="${k}" aria-pressed="${k === tab}">${l}</button>`).join("")}</div><div id="ptab"></div></div>`;
  finish();
  Promise.all([api("/etl/reconciliation"), api("/etl/stress-test")]).then(([rc, st]) => {
    const good = rc.cities.filter((c) => c.match).length;
    $("#pstrip").innerHTML = kpi(rc.files, "source files read") + kpi(rc.wh_rows, "rows in warehouse") + kpi(rc.duplicates, "duplicate rows", { cls: rc.duplicates ? "" : "good" }) + kpi(good, `of ${rc.cities.length} cities match their files exactly`, { cls: good === rc.cities.length ? "good" : "" }) + kpi(st.caught, `of ${st.planted} planted defects caught`, { cls: st.caught === st.planted ? "good" : "" });
    finish($("#pstrip"));
  }).catch((e) => { $("#pstrip").innerHTML = err(e); });
  const show = async () => {
    const box = $("#ptab"); box.innerHTML = skeleton();
    document.querySelectorAll("[data-t]").forEach((b) => b.setAttribute("aria-pressed", b.dataset.t === tab));
    const nav = { go: (t, fn) => { tab = t; openFn = fn || null; show(); window.scrollTo({ top: 0, behavior: "smooth" }); }, fn: () => openFn };
    try { await ({ sources: tabSources, journey: tabJourney, proof: tabProof, flagged: tabFlagged, code: tabCode }[tab])(box, nav); finish(box); growBars(box); }
    catch (e) { box.innerHTML = err(e); }
  };
  document.querySelectorAll("[data-t]").forEach((b) => b.addEventListener("click", () => { tab = b.dataset.t; openFn = null; show(); }));
  show();
}

/* ================================================== 1 · SOURCE FILES */
async function tabSources(box) {
  const inv = await api("/etl/inventory"); let city = inv.cities.some((c) => c.location_id === S.city) ? S.city : inv.cities[0].location_id, year = 2010, view2 = "raw";
  const byCity = inv.cities.map((c) => { const f = inv.files.filter((x) => x.location_id === c.location_id); return { ...c, files: f.length, rows: f.reduce((a, x) => a + x.rows, 0), mb: f.reduce((a, x) => a + x.kb, 0) / 1024 }; });
  box.innerHTML = `<p class="lede" style="margin:0 0 14px">These are the actual files the pipeline reads: <b>${inv.files.length} CSV files</b>, one per city per year, downloaded from the Open-Meteo archive (ERA5 reanalysis). Pick any one to open it like a spreadsheet.</p>
    <div class="tb controls"><div class="tgroup"><span class="cap">City</span><div class="chips" id="pc">${inv.cities.map((c) => `<button class="pill" data-pc="${c.location_id}" aria-pressed="${c.location_id === city}">${esc(c.city)}</button>`).join("")}</div></div>
    <label>Year<select id="py">${inv.years.map((y) => `<option ${y === year ? "selected" : ""}>${y}</option>`).join("")}</select></label></div><div id="src">${skeleton()}</div>
    <details class="card more" style="margin-top:16px"><summary>All ${inv.files.length} files at a glance</summary><div class="scroll" style="margin-top:10px"><table><thead><tr><th>City</th><th class="num">Files</th><th class="num">Hourly rows</th><th class="num">Size (MB)</th><th>Years covered</th></tr></thead><tbody>${byCity.map((c) => `<tr><td>${esc(c.city)}</td><td class="num">${c.files}</td><td class="num">${fmtn(c.rows)}</td><td class="num">${fmt(c.mb, 1)}</td><td>${inv.years[0]} to ${inv.years.at(-1)}</td></tr>`).join("")}<tr><th>Total</th><th class="num">${inv.files.length}</th><th class="num">${fmtn(byCity.reduce((a, c) => a + c.rows, 0))}</th><th class="num">${fmt(byCity.reduce((a, c) => a + c.mb, 0), 1)}</th><th></th></tr></tbody></table></div></details>`;
  const load = async () => {
    const el = $("#src"); el.innerHTML = skeleton();
    try {
      const d = await api(`/etl/source?${qs({ city, year })}`), cn = inv.cities.find((c) => c.location_id === city).city, m = d.monthly;
      const hotM = m.month[m.temp.indexOf(Math.max(...m.temp))], wetM = m.month[m.rain.indexOf(Math.max(...m.rain))], dryM = m.month[m.rain.indexOf(Math.min(...m.rain))];
      const xl = (head, rows, startRow, extra = []) => `<div class="scroll xlwrap"><table class="xl"><thead><tr><th class="corner"></th>${head.map((_, i) => `<th>${"ABCDEFGHIJKLMNOP"[i]}</th>`).join("")}</tr></thead><tbody>${extra.join("")}<tr class="hd"><th>${startRow}</th>${head.map((h) => `<td>${esc(h)}</td>`).join("")}</tr>${rows.map((r, i) => `<tr><th>${startRow + 1 + i}</th>${r.map((v, j) => `<td class="${j === 0 ? "t" : ""}">${esc(v)}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`;
      const metaRows = [`<tr class="meta"><th>1</th>${Object.keys(d.meta).map((k) => `<td>${esc(k)}</td>`).join("")}</tr>`, `<tr class="meta"><th>2</th>${Object.values(d.meta).map((k) => `<td>${esc(k)}</td>`).join("")}</tr>`, `<tr class="meta"><th>3</th><td colspan="6"></td></tr>`];
      const paint = () => {
        $("#xlbox").innerHTML = view2 === "raw" ? xl(d.raw_header, d.raw_rows, 4, metaRows) + `<p class="vxnote">Exactly as downloaded: rows 1-3 describe the location, row 4 holds the column names (with units in brackets), data starts at row 5.</p>`
          : xl(d.wh_header, d.mapped_rows.map((r, i) => [d.raw_rows[i][0], ...r]), 1) + `<p class="vxnote">After the Extract step: the same 14 rows with warehouse column names. Units moved into the name, so every city speaks the same language.</p>`;
        el.querySelectorAll("[data-xv]").forEach((b) => b.setAttribute("aria-pressed", b.dataset.xv === view2));
      };
      el.innerHTML = `<section class="card reveal"><div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;align-items:center"><h3 class="takeaway" style="margin:0">${esc(d.file)} · ${fmtn(d.n_rows)} rows × ${d.n_cols} columns · ${fmtn(d.size_kb)} KB</h3><div class="tabs" style="margin:0"><button data-xv="raw" aria-pressed="true">Raw file</button><button data-xv="mapped" aria-pressed="false">After extract</button></div></div><div id="xlbox" style="margin-top:12px"></div></section>
        <div style="margin-top:16px">${insights([["clock", "#0a6bd6", "File completeness", d.facts[0]], ["sun", "#d9480f", "Peak heat in the file", d.facts[1]], ["drop", "#0a8f8f", "Wettest day in the file", d.facts[2]], ["cloud", "#7048e8", "How often it rained", d.facts[3]]])}</div>
        <div class="grid g2"><section class="card reveal"><h3 class="takeaway">${esc(cn)} ${year}: hottest in ${MONTHS[hotM - 1]} (${fmt(Math.max(...m.temp), 1)} °C average), wettest in ${MONTHS[wetM - 1]} (${fmtn(Math.max(...m.rain))} mm), driest in ${MONTHS[dryM - 1]}</h3><p class="muted" style="margin:0 0 6px">Computed straight from this raw file, before any cleaning. The seasons are already visible, a good sign the file is sound.</p><div id="mchart" class="chart"></div></section>
        <section class="card reveal"><h3 class="takeaway">Evidence that this file reached the warehouse intact</h3><div class="vxnums" style="flex-wrap:wrap"><div><b>${fmtn(d.n_rows)}</b><span>rows in the file</span></div><div><b>${fmtn(d.warehouse.rows)}</b><span>rows in the warehouse for ${esc(cn)} ${year}</span></div><div><b class="${d.warehouse.match ? "okc" : "badc"}">${d.warehouse.match ? "✓ match" : "✗ differ"}</b><span>every hour accounted for</span></div></div><p class="muted">${fmtn(d.warehouse.flagged)} of these hours carry a “flagged” marker (unusual, but kept). Unit check: ${d.unit_mismatches.length ? esc(d.unit_mismatches.join("; ")) : "every column arrived in the expected unit ✓"}.</p></section></div>
        <section class="card reveal" style="margin-top:16px"><h3 class="takeaway">Column-by-column profile: ${d.stats.filter((s) => s.inside).length} of ${d.stats.length} columns sit inside physically possible limits</h3><p class="muted" style="margin:0 0 8px">What an analyst checks first. The little bars show how the values are spread; “allowed range” is the rule the Check step applies.</p><div class="scroll"><table><thead><tr><th>Column in file</th><th>Becomes</th><th class="num">Filled</th><th class="num">Min</th><th class="num">Median</th><th class="num">Mean</th><th class="num">Max</th><th>Spread</th><th>Allowed range</th><th>Inside?</th></tr></thead><tbody>${d.stats.map((s) => `<tr><td>${esc(s.raw.replace(/ \(.*\)/, "").replace(/_/g, " "))} <small class="muted">${esc(unit(s.raw))}</small></td><td><code>${esc(s.column)}</code></td><td class="num">${fmtn(s.non_null)}</td><td class="num">${fmt(s.min)}</td><td class="num">${fmt(s.p50)}</td><td class="num">${fmt(s.mean)}</td><td class="num">${fmt(s.max)}</td><td>${histSpark(s.hist)}</td><td>${s.limit[0]} to ${s.limit[1]}</td><td class="${s.inside ? "okc" : "badc"}">${s.inside ? "✓" : "✗"}</td></tr>`).join("")}</tbody></table></div></section>`;
      finish(el); paint();
      el.querySelectorAll("[data-xv]").forEach((b) => b.addEventListener("click", () => { view2 = b.dataset.xv; paint(); }));
      plot("#mchart", [{ type: "bar", x: MONTHS, y: m.rain, name: "Rain (mm)", marker: { color: "rgba(10,143,143,.35)" }, yaxis: "y2", hovertemplate: "%{x}: %{y:.0f} mm<extra></extra>" }, { type: "scatter", mode: "lines+markers", x: MONTHS, y: m.temp, name: "Avg temp (°C)", line: { color: "#d9480f", width: 3, shape: "spline" }, hovertemplate: "%{x}: %{y:.1f} °C<extra></extra>" }],
        { yaxis: { title: "°C" }, yaxis2: { overlaying: "y", side: "right", title: "mm of rain", showgrid: false }, height: 300, margin: { l: 54, r: 64, t: 12, b: 50 }, legend: { orientation: "h", y: -0.18 } }, `Monthly temperature and rain for ${cn} ${year}. Hottest ${MONTHS[hotM - 1]}, wettest ${MONTHS[wetM - 1]}.`);
    } catch (e) { el.innerHTML = err(e); }
  };
  box.querySelectorAll("[data-pc]").forEach((b) => b.addEventListener("click", () => { city = b.dataset.pc; box.querySelectorAll("[data-pc]").forEach((x) => x.setAttribute("aria-pressed", x === b)); load(); }));
  $("#py").addEventListener("change", (e) => { year = +e.target.value; load(); }); load();
}

/* ================================================== 2 · THE JOURNEY */
async function tabJourney(box, nav) {
  const runs = await api("/etl/runs"), ok = runs.filter((r) => r.status === "success"), lab = runLabels(runs), def = (ok.filter((r) => r.pipeline === "weather").sort((a, b) => b.rows_read - a.rows_read)[0] ?? ok[0] ?? runs[0]).run_id;
  box.innerHTML = `<section class="card reveal"><h3 class="takeaway">The pipeline has run ${runs.length} times. Pick a run to inspect its numbers.</h3><p class="muted" style="margin:0 0 10px">A “run” is one complete pass: read files → check → tidy → enrich → store. Each run is logged in the <code>etl.run_log</code> table with its own row counts.</p>
    <div class="scroll"><table class="runs"><thead><tr><th></th><th>Run</th><th>Pipeline</th><th>Started</th><th>What happened</th><th class="num">Rows read</th><th class="num">Rejected</th><th class="num">Table size after</th><th class="num">Took</th></tr></thead><tbody>${runs.map((r) => `<tr data-run="${r.run_id}" class="${r.run_id === def ? "sel" : ""}"><td><input type="radio" name="runpick" ${r.run_id === def ? "checked" : ""} aria-label="Select run ${r.run_id}"></td><th>#${r.run_id}</th><td>${r.pipeline === "weather" ? "Weather" : "Crops"}</td><td>${dlabel(r.started_at)}</td><td>${esc(lab[r.run_id])}</td><td class="num">${fmtn(r.rows_read ?? 0)}</td><td class="num">${fmtn(r.rows_rejected ?? 0)}</td><td class="num">${fmtn(r.rows_in_table_after ?? 0)}</td><td class="num">${fmt(r.runtime_s, 0)} s</td></tr>`).join("")}</tbody></table></div></section><div id="etl" style="margin-top:16px">${skeleton()}</div>`;
  let cur = "extract", curRun = def;
  const load = async () => {
    const el = $("#etl"); el.innerHTML = skeleton();
    box.querySelectorAll("tr[data-run]").forEach((t) => { t.classList.toggle("sel", +t.dataset.run === curRun); t.querySelector("input").checked = +t.dataset.run === curRun; });
    try {
      const d = await api("/etl/run/" + curRun), r = d.reconciliation, W = d.run.pipeline === "weather", st = d.steps, by = (k) => st.filter((s) => s.stage === k);
      const dup = st.find((s) => /Duplicate/.test(s.step_name))?.rows_affected ?? 0, miss = d.quality.filter((q) => q.phase === "clean").reduce((a, q) => a + +q.n_missing, 0), outl = d.outliers_by_city.reduce((a, c) => a + c.outlier_hours, 0);
      const balanced = W ? r.rows_read - r.rejected + r.rows_added_gap_fill === r.transformed && r.loaded === r.transformed : r.loaded === r.transformed;
      const nodes = [["extract", "Collect", W ? "Read files" : "Read crop table", r.rows_read], ["validate", "Check", W ? "Test every row" : "Filter and test", r.rows_read - r.rejected], ["clean", "Tidy", W ? "Fill gaps, flag outliers" : "Remove duplicates", r.transformed], ...(W ? [["transform", "Enrich", "Add heat index", r.transformed]] : []), ["load", "Store", "Upsert into tables", r.loaded]];
      const visual = (k) => {
        if (k === "extract") return `<div class="vx"><div class="vxr"><span class="vxf">DEL_2002.csv</span><span class="vxf">BOM_2002.csv</span><span class="vxf">+ ${W ? "208" : "0"} more files</span></div><div class="vxa">↓ one table, ${fmtn(r.rows_read)} rows</div><div class="vxt old">temperature_2m (°C) · relative_humidity_2m (%) · wind_speed_10m (km/h)</div><div class="vxa">↓ same names and units</div><div class="vxt new">temperature_c · relative_humidity_pct · wind_speed_kmh</div></div>`;
        if (k === "validate") return `<div class="vx gates">${by("validate").slice(0, 3).map((s, i) => gate(["clock", "layers", "shield"][i], ["#e67700", "#7048e8", "#0a6bd6"][i], esc(s.step_name.replace("Physical range check", "Possible values").replace("Timestamp parsing", "Readable time").replace("Duplicate detection", "Unique city-hour").replace("Value and consistency checks", "Consistent values").replace("Filter to supported districts", "Our districts only")), ({ "Timestamp parsing": "time parses", "Duplicate detection": "no repeats", "Physical range check": "−90 ≤ T ≤ 60 · 0 ≤ RH ≤ 100" }[s.step_name] ?? "rule applied"), s.step_name.startsWith("Filter") ? 0 : s.rows_affected)).join("")}</div><div class="vxq">↳ Failing rows → quarantine table <b>${fmtn(d.quarantine_count)}</b>${W ? " · the Proof lab plants bad rows to show the gates really work" : ""}</div>`;
        if (k === "clean") return `<div class="vx"><div class="vxdots">${[...Array(14)].map((_, i) => `<i class="${i === 5 ? "gap" : i === 10 ? "flag" : ""}"></i>`).join("")}</div><div class="vxlegend"><span><i class="gap"></i> missing hour → filled (≤ 3 h)</span><span><i class="flag"></i> unusual reading → flagged, kept</span></div><div class="vxnums"><div><b>${fmtn(r.rows_added_gap_fill ?? 0)}</b><span>gap rows added</span></div><div><b>${fmtn(miss)}</b><span>missing values</span></div><div><b>${fmtn(outl)}</b><span>flagged readings</span></div></div><p class="vxnote">${miss === 0 && W ? "The ERA5 source files were already complete, so this run had nothing to fill. The Proof lab shows gap-filling working on planted gaps." : "Counts are from this run."}</p></div>`;
        if (k === "transform") return `<div class="vx"><div class="vxform"><div><b>32 °C</b><span>temperature</span></div><em>+</em><div><b>70%</b><span>humidity</span></div><em>→</em><div class="res"><b>≈ 41 °C</b><span>feels like</span></div></div><p class="vxnote">Example of the heat index. Wet-bulb temperature and date/hour keys are added the same way.</p></div>`;
        return `<div class="vx"><div class="vxups"><div class="vxt new">clean row</div><em>→</em><div class="vxq2">city-hour already stored?</div><div class="vxbr"><span class="u">yes: update</span><span class="i">no: insert</span></div></div><div class="vxnums"><div><b>${fmtn(r.loaded)}</b><span>rows upserted</span></div><div><b>${fmtn(r.rows_in_table_after)}</b><span>rows in the table</span></div></div><p class="vxnote">${balanced ? "✓ Re-running leaves the table at the same size." : "Check counts."}</p></div>`;
      };
      const cmpv = (x, y) => (x === undefined || x === null ? (y === undefined || y === null ? "n/a" : fmt(y)) : y === undefined || y === null || x === y ? fmt(x) : `${fmt(x)} → <b class="fixc">${fmt(y)}</b>`);
      const statTable = (s) => { const b = s.before_stats, a = s.after_stats; if (!b && !a) return ""; const src = b || a, keys = Object.keys(src).filter((k) => src[k] && typeof src[k] === "object" && "mean" in src[k]).slice(0, 5); if (!keys.length) return `<p class="muted" style="margin:0">${esc(Object.entries(src).map(([k, v]) => `${k.replace(/_/g, " ")}: ${typeof v === "object" ? JSON.stringify(v) : v}`).join(" · "))}</p>`; return `<div class="scroll" style="max-height:none"><table class="ptb2"><thead><tr><th>Variable</th><th>Missing</th><th>Min</th><th>Mean</th><th>Max</th></tr></thead><tbody>${keys.map((k) => { const x = b?.[k], y = a?.[k]; return `<tr><td>${esc(k.replace(/_/g, " "))}</td><td>${cmpv(x?.missing, y?.missing)}</td><td>${cmpv(x?.min, y?.min)}</td><td>${cmpv(x?.mean, y?.mean)}</td><td>${cmpv(x?.max, y?.max)}</td></tr>`; }).join("")}</tbody></table></div><small class="vxnote">Measured on the real data before → after this step. “a → b” appears only where the step changed a value.</small>`; };
      const panel = (k) => { const subs = by(k), t = nodes.find((n) => n[0] === k);
        return `<div class="stepbox" style="border-top:4px solid ${PCOL[k]}"><h3 style="font-size:20px">${t[1]} <span class="badge">${fmtn(t[3])} rows out</span></h3><p class="muted" style="margin:0 0 6px">${esc(PWHAT[k])}</p>${visual(k)}<h4 class="sh" style="margin:14px 0 4px">A row, before and after</h4>${psample(k)}
          <h4 class="sh" style="margin:14px 0 4px">Evidence from this run</h4>${subs.map((s) => `<div class="evs"><div class="evh"><b>${esc(s.step_name)}</b><span class="badge ${s.rows_affected ? "warn" : "ok"}">${fmtn(s.rows_affected)} rows affected</span></div><p>${esc(s.purpose)}</p>${statTable(s)}</div>`).join("") || "<p class='muted'>No logged sub-steps.</p>"}
          ${W ? `<h4 class="sh" style="margin:14px 0 6px">The code that does this</h4><div class="pillrow">${STAGE_FN[k].map((f) => `<button class="ghost" data-fn="${f}">${f}()</button>`).join("")}</div>` : ""}</div>`; };
      el.innerHTML = `<div class="kpis">${kpi(r.rows_read, "rows read")}${kpi(r.rejected, "rows rejected", { cls: r.rejected ? "" : "good" })}${kpi(dup, "duplicates", { cls: dup ? "" : "good" })}${W ? kpi(miss, "missing values", { cls: miss ? "" : "good" }) : ""}${W ? kpi(outl, "flagged readings") : ""}${kpi(r.rows_in_table_after, "rows in warehouse")}</div>
        <div class="pplay reveal"><button id="play" class="primary">▶ Play the journey</button><span id="pcap">Press play and watch one data row travel through all the steps.</span></div><div class="flow2"><div class="vflow" role="group" aria-label="Pipeline steps"><div class="vnode src"><span class="vb">${ico("db", "#fff", 18)}</span><span class="vt"><b>Source files</b><small>${W ? "210 city-year CSV files" : "National crop table"}</small></span><span class="vio"><span><small>rows collected</small><b>${fmtn(r.rows_read)}</b></span></span></div>${nodes.map((n, i) => `<div class="varrow"><i></i></div><button class="vnode" data-k="${n[0]}" aria-pressed="${n[0] === cur}" style="--c:${PCOL[n[0]]}"><span class="vb">${i + 1}</span><span class="vt"><b>${n[1]}</b><small>${n[2]}</small></span><span class="vio"><span><small>rows in</small><b>${fmtn(i ? nodes[i - 1][3] : r.rows_read)}</b></span><i>→</i><span><small>rows out</small><b>${fmtn(n[3])}</b></span></span><span class="vplain">${PPLAIN[n[0]][0]}</span></button>${n[0] === "validate" ? `<div class="vbranch">↳ Quarantine: <b>${fmtn(r.rejected)}</b> rows</div>` : ""}`).join("")}<div class="varrow"><i></i><span>${balanced ? "✓ all rows accounted for" : "check counts"}</span></div><div class="vnode end"><span class="vb">${ico("check", "#fff", 18)}</span><span class="vt"><b>Warehouse</b><small>star + snowflake tables</small></span><span class="vio"><span><small>rows now in the warehouse</small><b>${fmtn(r.rows_in_table_after)}</b></span></span></div></div>
          <div class="sticky" id="ppanel" aria-live="polite">${panel(cur)}</div></div>
        <section class="card" style="margin-top:16px"><h3 style="margin-top:0">The pipeline in everyday words</h3><div class="scroll"><table class="cmp pguide"><thead><tr><th>Step</th><th>Think of it as</th><th>What really happens</th><th>Technology used</th><th>Without it…</th></tr></thead><tbody>${PGUIDE.map((g, i) => `<tr style="--c:${Object.values(PCOL)[i] ?? "#6e6e73"}"><th>${g[0]}</th><td>${g[1]}</td><td>${g[2]}</td><td><span class="tech">${g[3]}</span></td><td>${g[4]}</td></tr>`).join("")}</tbody></table></div></section>
        <details class="card more" style="margin-top:10px"><summary>Variable profile after cleaning (all rows in this run)</summary>${d.quality.length ? `<div class="scroll" style="margin-top:10px"><table><thead><tr><th>Variable</th><th class="num">Missing</th><th class="num">Min</th><th>Mean position</th><th class="num">Mean</th><th class="num">Max</th></tr></thead><tbody>${d.quality.filter((q) => q.phase === "clean").map((q) => `<tr><td>${esc(q.variable.replace(/_/g, " "))}</td><td class="num">${fmtn(+q.n_missing)}</td><td class="num">${fmt(q.v_min)}</td><td><div class="rangebar"><i style="left:${Math.max(0, Math.min(100, ((q.v_mean - q.v_min) / ((q.v_max - q.v_min) || 1)) * 100))}%"></i></div></td><td class="num">${fmt(q.v_mean)}</td><td class="num">${fmt(q.v_max)}</td></tr>`).join("")}</tbody></table></div>` : "<p>No profile for this run.</p>"}</details>
        ${d.quarantine_count ? `<details class="card more" style="margin-top:10px"><summary>Quarantined rows (${fmtn(d.quarantine_count)})</summary>${table(d.quarantine_sample)}</details>` : `<p class="muted" style="margin-top:10px">The quarantine table for this run is empty: no row broke a rule. That is expected for ERA5 files, which is why the Proof lab plants defects to show the gates really work.</p>`}`;
      finish(el);
      const bindFn = () => el.querySelectorAll("[data-fn]").forEach((b) => b.addEventListener("click", () => nav.go("code", b.dataset.fn)));
      const setCur = (k) => { cur = k; el.querySelectorAll(".vnode[data-k]").forEach((x) => x.setAttribute("aria-pressed", x.dataset.k === k)); $("#ppanel").innerHTML = panel(k); bindFn(); };
      el.querySelectorAll(".vnode[data-k]").forEach((b) => b.addEventListener("click", () => setCur(b.dataset.k))); bindFn();
      let timer = null;
      $("#play").addEventListener("click", () => { clearInterval(timer); const ks = nodes.map((n) => n[0]); let i = 0; const cap = $("#pcap");
        const say = { extract: "1 · A row is collected from a file and renamed.", validate: "2 · It is checked. Bad rows go to quarantine.", clean: "3 · Gaps are filled, odd values flagged.", transform: "4 · Heat index and keys are added.", load: "5 · Saved into the warehouse, once." };
        const step = () => { if (i >= ks.length) { clearInterval(timer); cap.textContent = "✓ Done: the row is in the warehouse and ready for charts and models."; return; } setCur(ks[i]); cap.textContent = say[ks[i]] ?? ""; i++; };
        step(); timer = setInterval(step, 3200); });
    } catch (e) { el.innerHTML = err(e); }
  };
  box.querySelectorAll("tr[data-run]").forEach((t) => t.addEventListener("click", () => { curRun = +t.dataset.run; cur = "extract"; load(); })); load();
}

/* ================================================== 3 · PROOF LAB */
async function tabProof(box) {
  const [st, rc] = await Promise.all([api("/etl/stress-test"), api("/etl/reconciliation")]);
  const allOk = st.caught === st.planted, runsW = rc.runs, last = runsW.at(-1);
  box.innerHTML = `<section class="card reveal"><h3 class="takeaway">${allOk ? `Test 1 · Break it on purpose: all ${st.planted} planted defects were caught` : `Test 1 · ${st.caught} of ${st.planted} planted defects were caught`}</h3>
    <p class="muted" style="margin:0 0 10px">The real source files contain no errors, so “0 rows rejected” alone proves nothing. To prove the gates work, we take <b>${fmtn(st.sample_rows)} real rows</b> from <code>DEL_2010.csv</code>, plant ${st.planted} known defects, and run the <b>actual pipeline functions</b> on them. This runs live every time you open the page.</p>
    <div class="scroll" style="max-height:none"><table class="proof"><thead><tr><th>Defect planted</th><th>How it was planted</th><th>Rule that should stop it</th><th>What the pipeline did</th><th></th></tr></thead><tbody>${st.cases.map((c) => `<tr><th>${esc(c.case)}</th><td><code>${esc(c.planted)}</code></td><td>${esc(c.rule)}</td><td>${esc(c.result)}</td><td class="${c.caught ? "okc" : "badc"}">${c.caught ? "✓ caught" : "✗ missed"}</td></tr>`).join("")}</tbody></table></div>
    <div class="cols2" style="margin-top:14px"><div><h4 class="sh">Gap filling, hour by hour</h4><p class="muted" style="margin:0 0 6px">Two hours were deleted from a hot afternoon. The pipeline rebuilt them with a straight line between the neighbours:</p><div class="scroll" style="max-height:none"><table class="ptb2"><thead><tr><th>Hour</th><th>Temperature °C</th><th>Source</th></tr></thead><tbody>${st.interpolation_example.map((x) => `<tr class="${x.filled ? "fixrow" : ""}"><td>${esc(x.time)}</td><td>${fmt(x.temperature_c, 1)}</td><td>${x.filled ? "filled by straight line" : "real reading"}</td></tr>`).join("")}</tbody></table></div></div>
    <div><h4 class="sh">Try your own value</h4><p class="muted" style="margin:0 0 6px">Uses the same limits as <code>HARD_RANGES</code> in the code.</p><div class="controls" style="margin:0"><label>Variable<select id="tv">${Object.keys(st.ranges).map((k) => `<option value="${k}">${k.replace(/_/g, " ")}</option>`).join("")}</select></label><label>Value<input type="number" id="tn" value="999" step="any" style="width:110px"></label></div><div id="tverdict" class="verdict"></div></div></div></section>
    <div class="grid g2" style="margin-top:16px"><section class="card reveal"><h3 class="takeaway">Test 2 · Do the numbers add up? ${rc.cities.every((c) => c.match) ? `Yes: ${fmtn(rc.file_rows)} rows in the files = ${fmtn(rc.wh_rows)} rows in the warehouse` : "Some cities do not reconcile"}</h3><p class="muted" style="margin:0 0 8px">Rows counted in the CSV files vs rows counted in PostgreSQL, per city. “Unique hours” counts distinct (date, hour) pairs, so a duplicate would show up as a lower number.</p><div class="scroll" style="max-height:none"><table><thead><tr><th>City</th><th class="num">File rows</th><th class="num">Warehouse rows</th><th class="num">Unique hours</th><th>Span</th><th></th></tr></thead><tbody>${rc.cities.map((c) => `<tr><td>${esc(c.city)}</td><td class="num">${fmtn(c.file_rows)}</td><td class="num">${fmtn(c.wh_rows)}</td><td class="num">${fmtn(c.distinct)}</td><td>${String(c.first_day).replace(/(\d{4})(\d\d)(\d\d)/, "$1-$2-$3")} → ${String(c.last_day).replace(/(\d{4})(\d\d)(\d\d)/, "$1-$2-$3")}</td><td class="${c.match ? "okc" : "badc"}">${c.match ? "✓" : "✗"}</td></tr>`).join("")}</tbody></table></div><p class="vxnote">Expected per city: 7,670 days × 24 hours = 184,080 rows. The quarantine table holds ${fmtn(rc.quarantined)} rows.</p></section>
    <section class="card reveal"><h3 class="takeaway">Test 3 · Run it again, get the same table: ${runsW.length} weather runs loaded ${fmtn(rc.loaded_total_all_runs)} rows in total, yet the table holds ${fmtn(last.table_after)}</h3><p class="muted" style="margin:0 0 6px">If the pipeline simply appended rows, the table would be the sum of the bars. Because it upserts on the key (city, date, hour), repeated loads only update.</p><div id="idem" class="chart"></div></section></div>`;
  const verdict = () => { const k = $("#tv").value, v = +$("#tn").value, [lo, hi] = st.ranges[k], good = v >= lo && v <= hi; $("#tverdict").className = "verdict " + (good ? "ok" : "bad"); $("#tverdict").innerHTML = good ? `✓ <b>${v}</b> is inside ${lo} to ${hi}: the row <b>passes</b>.` : `✗ <b>${v}</b> is outside ${lo} to ${hi}: the row goes to the <b>quarantine table</b> with the reason “${k} outside physical range”.`; };
  $("#tv").addEventListener("change", verdict); $("#tn").addEventListener("input", verdict); verdict();
  plot("#idem", [{ type: "bar", name: "Rows loaded in this run", x: runsW.map((r) => "Run #" + r.run_id), y: runsW.map((r) => r.rows_loaded), marker: { color: "#E69F00" }, hovertemplate: "%{x}: loaded %{y:,}<extra></extra>" }, { type: "scatter", mode: "lines+markers", name: "Rows in the table afterwards", x: runsW.map((r) => "Run #" + r.run_id), y: runsW.map((r) => r.table_after), line: { color: "#0072B2", width: 3 }, hovertemplate: "%{x}: table holds %{y:,}<extra></extra>" }],
    { yaxis: { title: "rows", tickformat: ",.2s" }, height: 300 }, `Bars show rows loaded per run; the line shows table size afterwards, which stays at ${fmtn(last.table_after)}.`, { animate: false });
}

/* ================================================== 4 · FLAGGED READINGS */
async function tabFlagged(box) {
  const f = await api("/etl/flagged"), vars = Object.keys(VARS), pct = (100 * f.flagged_hours) / f.total_hours;
  const sumBy = (key, val) => f.grid.filter((g) => g[key] === val).reduce((a, g) => a + g.n, 0), byVar = vars.map((v) => ({ v, n: sumBy("var", v) })), byCity = f.cities.map((c) => ({ c, n: sumBy("city", c) })).sort((a, b) => b.n - a.n);
  const monthTot = MONTHS.map((_, i) => f.by_month.filter((m) => m.month === i + 1).reduce((a, m) => a + m.n, 0)), topM = monthTot.indexOf(Math.max(...monthTot)), topV = byVar.slice().sort((a, b) => b.n - a.n)[0];
  const z = f.cities.map((c) => vars.map((v) => f.grid.find((g) => g.city === c && g.var === v)?.n ?? 0));
  box.innerHTML = `<p class="lede" style="margin:0 0 14px">“Flagged” means a reading looked unusual compared with the same city, month and hour (more than 6 robust standard deviations from the median). Flagged readings are <b>kept, not deleted</b>, because real extremes such as storms and heatwaves are exactly what a weather model needs to see.</p>
    <div class="kpis">${kpi(f.flagged_hours, "flagged hours")}${kpi(pct, "% of all hours", { dec: 3 })}${kpi(topV.n, `flagged for ${VARS[topV.v].toLowerCase()}`)}${kpi(byCity[0].n, `in ${byCity[0].c}, the most`)}</div>
    <div class="grid g2"><section class="card reveal"><h3 class="takeaway">${VARS[topV.v]} causes ${Math.round((100 * topV.n) / byVar.reduce((a, b) => a + b.n, 0))}% of flags, and ${byCity[0].c} has the most (${fmtn(byCity[0].n)})</h3><p class="muted" style="margin:0 0 6px">Flagged hours by city and variable. Wind is naturally spiky (calm hours, then sudden gusts), so it trips the rule more often than temperature or pressure.</p><div id="fh" class="chart"></div></section>
    <section class="card reveal"><h3 class="takeaway">Flags are not spread evenly: ${MONTHS[topM]} has the most (${fmtn(monthTot[topM])}) and Jun to Aug almost none</h3><p class="muted" style="margin:0 0 6px">Random data-entry errors would be spread evenly through the year. Seasonal clustering points to weather behaviour (for example, the steadier monsoon months produce few unusual readings), though we cannot prove each flag is a real event.</p><div id="fm" class="chart"></div></section></div>
    <section class="card reveal" style="margin-top:16px"><h3 class="takeaway">Real flagged readings: how far from normal were they?</h3><p class="muted" style="margin:0 0 8px">A sample straight from the warehouse. “Typical” is the median for that city, month and hour of day across 21 years.</p><div class="scroll"><table><thead><tr><th>City</th><th>When</th><th>Variable</th><th class="num">Value</th><th class="num">Typical</th><th>Verdict</th></tr></thead><tbody>${f.examples.map((x) => `<tr><td>${esc(x.city)}</td><td>${esc(x.when)}</td><td>${esc(x.variable)}</td><td class="num">${fmt(x.value, 1)}</td><td class="num">${x.typical === null ? "n/a" : fmt(x.typical, 1)}</td><td>${x.typical === null ? "Pressure unusual for this city, month and hour" : x.value > x.typical ? `${fmt(x.value - x.typical, 1)} above typical` : `${fmt(x.typical - x.value, 1)} below typical`}: kept, marked <code>is_outlier</code></td></tr>`).join("")}</tbody></table></div></section>
    <details class="card more" style="margin-top:10px"><summary>How the rule works</summary><p>For each city, month and hour of the day we compute the median and the median absolute deviation (MAD). A reading is flagged when it is more than <code>6 × 1.4826 × MAD</code> away from the median. The rule is applied to temperature, pressure and wind speed. A reading is never removed: the column <code>is_outlier</code> is set and the reason is written to <code>qc_note</code>.</p></details>`;
  plot("#fh", [{ type: "heatmap", z, x: vars.map((v) => VARS[v]), y: f.cities, colorscale: [[0, "#fff8e7"], [1, "#d9480f"]], text: z.map((r) => r.map((v) => fmtn(v))), texttemplate: "%{text}", hovertemplate: "%{y} · %{x}: %{z:,} hours<extra></extra>", showscale: false }], { height: 380, margin: { l: 90, r: 10, t: 6, b: 40 }, yaxis: { autorange: "reversed" } }, `Heatmap of flagged hours by city and variable. ${byCity[0].c} highest overall.`, { animate: false });
  plot("#fm", vars.map((v, i) => ({ type: "bar", name: VARS[v], x: MONTHS, y: MONTHS.map((_, m) => f.by_month.find((b) => b.month === m + 1 && b.var === v)?.n ?? 0), marker: { color: ["#d9480f", "#7048e8", "#0a8f8f"][i] }, hovertemplate: `%{x} · ${VARS[v]}: %{y:,}<extra></extra>` })), { barmode: "stack", height: 380, yaxis: { title: "flagged hours" } }, `Stacked bars of flagged hours by month. Peak in ${MONTHS[topM]}.`, { animate: false });
}

/* ================================================== 5 · CODE */
async function tabCode(box, nav) {
  const mods = await api("/etl/code"), want = nav.fn();
  box.innerHTML = `<p class="lede" style="margin:0 0 14px">The generalised ETL code: nine small functions in <code>etl_weather.py</code> (one per task) and two formulas in <code>derived.py</code>. Open any function to read its real source.</p>
    <div class="flowcode">${Object.entries(PCOL).map(([k, c]) => `<span style="--c:${c}">${k}</span>`).join("<i>→</i>")}</div>
    ${mods.map((m) => `<section class="card reveal" style="margin-top:14px"><h3 class="takeaway">${esc(m.file)} <span class="badge">${m.lines} lines</span></h3><p class="muted" style="margin:0 0 10px">${esc(m.role)}</p>${m.constants.length ? `<details class="more" style="margin:0 0 10px"><summary>Settings that control the rules</summary><pre>${esc(m.constants.join("\n"))}</pre></details>` : ""}${m.functions.map((fn) => `<details class="fnd" ${want === fn.name ? "open" : ""} id="fn_${fn.name}" style="--c:${PCOL[fn.stage]}"><summary><span class="stg">${fn.stage}</span><b>${fn.name}()</b><small>${esc(fn.summary)}</small></summary><pre><code>${esc(fn.source)}</code></pre></details>`).join("")}</section>`).join("")}`;
  if (want) setTimeout(() => document.getElementById("fn_" + want)?.scrollIntoView({ block: "center", behavior: "smooth" }), 120);
}
